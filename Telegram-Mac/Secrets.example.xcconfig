//
//  Secrets.example.xcconfig
//
//  Copy to Secrets.xcconfig (git-ignored) and fill in your signing team.
//  The app asks for api_id / api_hash from my.telegram.org on first start.
//

// Apple team ID used for code signing (Xcode -> Settings -> Accounts).
DEVELOPMENT_TEAM =

// Optional: sign Release with Developer ID instead of Apple Development.
// Fill in the names of your Developer ID provisioning profiles.
// TELEX_RELEASE_SIGN_STYLE = Manual
// TELEX_RELEASE_SIGN_IDENTITY = Developer ID Application
// TELEX_APP_PROFILE = <profile for com.korthane.telex>
// TELEX_SHARE_PROFILE = <profile for com.korthane.telex.TelegramShare>
