+    if (depth <= kMaxTokenizeDepth)
+    {
+        try {
+            matchGrammar(text, tokenList, grammar, tokenList.head, 0, nullptr, depth);
+        } catch (...) {
+        }
     }
 
     return tokenList;
 }
 
